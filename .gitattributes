# Enforce LF line endings on Windows for all scripts, sources, manifests, and
# build configuration files while preserving mail patches and binary fixtures.

* text=auto eol=lf

# Shell scripts, Python tools, build configs, and TSV/ENV manifests must stay LF.
*.sh text eol=lf
*.py text eol=lf
*.tsv text eol=lf
*.env text eol=lf
*.conf text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
CMakePresets.json text eol=lf
meson.build text eol=lf
meson_options.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.plist.in text eol=lf
*.entitlements text eol=lf
*.xcconfig text eol=lf
*.xcconfig.example text eol=lf
*.modulemap text eol=lf
*.modulemap.in text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf

# C/C++/ObjC++/Swift/Assembly sources and contracts.
*.inc text eol=lf
*.ipp text eol=lf
*.inl text eol=lf
*.S text eol=lf
*.s text eol=lf
*.asm text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.hxx text eol=lf
*.m text eol=lf
*.mm text eol=lf
*.swift text eol=lf

# Android build / policy files.
*.bp text eol=lf
*.rc text eol=lf
*.te text eol=lf
*.java text eol=lf
*.ld text eol=lf
*.mk text eol=lf

# Preserve patch files byte-for-byte (several FEX patches contain upstream CR).
*.patch -text

# Binary formats.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.raw binary
*.pack binary
*.bin binary
*.gz binary
*.xz binary
*.zst binary
*.tar binary
*.erofs binary
*.img binary
*.ipa binary
*.a binary
*.dylib binary
*.so binary

# Mail patches contain required unified-diff markers which resemble whitespace errors.
kernel/*/patches/series/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
kernel/common/patches/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
kernel/*/slices/*/patches/series/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
android/*/patches/projects/*/series/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
android/*/third_party/*/patches/projects/*/series/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
android/*/third_party/*/series/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
dependencies/patches/*/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
tools/rootfs/vulkan/patches/*/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# Exact resolved Repo manifests may preserve upstream whitespace verbatim.
android/*/third_party/*/base-manifest.xml whitespace=-blank-at-eol,-blank-at-eof
